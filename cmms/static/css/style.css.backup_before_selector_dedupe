/*  tree manage === Search Box === */
:root {
  --primary: #3b82f6;
  --primary-dark: #2563eb;
  --primary-light: #dbeafe;
  --success: #10b981;
  --success-light: #d1fae5;
  --warning: #f59e0b;
  --warning-light: #fef3c7;
  --danger: #ef4444;
  --danger-light: #fee2e2;
  --info: #06b6d4;
  --info-light: #cffafe;
  --purple: #8b5cf6;
  --purple-light: #ede9fe;
  --bg-light: #f1f5f9;
  --bg-card: #ffffff;
  --border: #e2e8f0;
  --border-light: #f1f5f9;
  --text-primary: #0f172a;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.1);
  --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  --radius: 0.75rem;
  --radius-lg: 1rem;
  --master-accent: var(--primary);
  --master-accent-50: var(--primary-light);
}

.search-box-modern input {
  width: 100%;
  padding: 0.625rem 1rem 0.625rem 2.5rem;
  border: 2px solid var(--border);
  border-radius: var(--radius);
  font-size: 0.9rem;
  transition: all 0.2s ease;
  background: white;
}

.search-box-modern i {
  position: absolute;
  left: 0.875rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  pointer-events: none;
}

.empty-state i {
  font-size: 4rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
  opacity: 0.5;
}

.empty-state h4 {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 0.5rem;
}

.empty-state p {
  font-size: 0.95rem;
  color: var(--text-muted);
}

/* === Parent Picker Modal === */
.modal-modern .modal-content {
  border-radius: var(--radius-lg);
  border: none;
  box-shadow: var(--shadow-xl);
}

.modal-modern .modal-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  border: none;
  padding: 1.5rem 2rem;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.modal-modern .modal-title {
  font-weight: 700;
  font-size: 1.35rem;
}

.modal-modern .btn-close {
  filter: brightness(0) invert(1);
  opacity: 0.8;
}

.modal-modern .modal-body {
  padding: 2rem;
}

.modal-modern .modal-footer {
  border: none;
  padding: 1.5rem 2rem;
  background: var(--bg-light);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}

/* Parent picker tree */
#mi-parent-display {
  background: var(--bg-light);
  border-right: 0;
  border-radius: var(--radius) 0 0 var(--radius);
}

#mi-change-parent-btn {
  border-left: 0;
  border-radius: 0 var(--radius) var(--radius) 0;
}

#parent-picker-tree .picker-node-row {
  padding: 0.5rem 0.75rem;
  border-radius: var(--radius);
  cursor: pointer;
  transition: all 0.2s ease;
}

#parent-picker-tree .picker-node-row:hover {
  background: var(--primary-light);
}

#parent-picker-tree .picker-selected {
  background: linear-gradient(90deg, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
  border-left: 3px solid var(--primary);
}

#parent-picker-preview {
  min-height: 48px;
  white-space: pre-wrap;
  padding: 0.75rem;
  background: var(--bg-light);
  border-radius: var(--radius);
  font-size: 0.9rem;
  color: var(--text-primary);
}

.picker-children {
  margin-left: 1.5rem;
  padding-left: 0.75rem;
  border-left: 2px dashed var(--border);
}

/* Form Controls */
.form-control-modern {
  border-radius: var(--radius);
  border: 2px solid var(--border);
  padding: 0.625rem 0.875rem;
  font-size: 0.9rem;
  transition: all 0.2s ease;
  background: white;
}

.form-control-modern.is-invalid {
  border-color: var(--danger);
}

.form-label-modern {
  font-weight: 600;
  font-size: 0.875rem;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
  display: block;
}
  
  .node-header {
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .category-sidebar {
    position: static;
    margin-bottom: 1.5rem;
  }
}













