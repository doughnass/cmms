{% extends 'base.html' %}
{% load thai_dates %}
{% block title %}<title>ใบงาน #{{ wo.id }} | CMMS</title>{% endblock %}

{% block extra_css %}
<style>
    /* ============================================
       Work Order Detail — Modern Design
       ============================================ */

    /* Back Button */
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #64748b;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 0;
        margin-bottom: 1rem;
        transition: color 0.2s;
    }
    .btn-back:hover { color: #667eea; }

    /* Hero */
    .wo-detail-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2rem 2.5rem;
        margin-bottom: 1.5rem;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .wo-detail-hero::before {
        content: '';
        position: absolute;
        top: -50%; right: -10%;
        width: 300px; height: 300px;
        background: rgba(255,255,255,0.08);
        border-radius: 50%;
    }
    .wo-detail-hero::after {
        content: '';
        position: absolute;
        bottom: -40%; left: 5%;
        width: 200px; height: 200px;
        background: rgba(255,255,255,0.05);
        border-radius: 50%;
    }
    .wo-detail-hero * { position: relative; z-index: 1; }
    .wo-detail-id {
        font-size: 0.85rem;
        font-weight: 600;
        opacity: 0.8;
        margin-bottom: 0.25rem;
    }
    .wo-detail-hero h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 0 0.75rem;
        line-height: 1.3;
    }
    .hero-badges { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.3rem 0.75rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }
    .hero-badge.s-open { background: rgba(59,130,246,0.3); }
    .hero-badge.s-assigned { background: rgba(139,92,246,0.3); }
    .hero-badge.s-in_progress { background: rgba(245,158,11,0.3); }
    .hero-badge.s-completed { background: rgba(34,197,94,0.3); }
    .hero-badge.s-verified { background: rgba(6,182,212,0.3); }
    .hero-badge.s-closed { background: rgba(156,163,175,0.3); }
    .hero-badge.p-low { background: rgba(34,197,94,0.3); }
    .hero-badge.p-medium { background: rgba(245,158,11,0.3); }
    .hero-badge.p-high { background: rgba(239,68,68,0.3); }
    .hero-badge.sr-badge { background: rgba(255,255,255,0.2); }
    .hero-badge.suggest-badge { background: rgba(59,130,246,0.3); }

    .hero-meta {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        font-size: 0.85rem;
        opacity: 0.9;
        text-align: right;
    }
    .hero-meta div { display: flex; align-items: center; gap: 0.5rem; justify-content: flex-end; }

    /* Workflow Stepper */
    .wo-stepper-wrap {
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.04);
        overflow-x: auto;
    }
    .wo-stepper {
        display: flex;
        align-items: flex-start;
        min-width: 500px;
    }
    .stepper-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 0 0 auto;
    }
    .stepper-dot {
        width: 36px; height: 36px;
        border-radius: 50%;
        background: #e2e8f0;
        display: flex;
        align-items: center; justify-content: center;
        font-size: 0.8rem; font-weight: 700;
        color: #94a3b8;
        transition: all 0.3s;
    }
    .stepper-step.done .stepper-dot {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff;
    }
    .stepper-step.current .stepper-dot {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        box-shadow: 0 0 0 4px rgba(102,126,234,0.2);
    }
    .stepper-label {
        font-size: 0.7rem; font-weight: 500;
        color: #94a3b8; margin-top: 0.5rem;
        white-space: nowrap;
    }
    .stepper-step.done .stepper-label { color: #16a34a; }
    .stepper-step.current .stepper-label { color: #667eea; font-weight: 600; }

    .stepper-connector {
        flex: 1; height: 3px;
        background: #e2e8f0;
        margin: 16px 0.5rem 0;
        border-radius: 2px;
        transition: background 0.3s;
        min-width: 30px;
    }
    .stepper-connector.filled {
        background: linear-gradient(90deg, #22c55e, #16a34a);
    }

    /* Cards */
    .wo-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .wo-card .card-hdr {
        background: #f8fafc;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }
    .wo-card .card-hdr i { font-size: 1.1rem; color: #667eea; }
    .wo-card .card-hdr h5 { margin: 0; font-size: 0.95rem; font-weight: 600; color: #1e293b; }
    .wo-card .card-bdy { padding: 1.5rem; }

    /* Sidebar Cards */
    .wo-sidebar-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .wo-sidebar-card .sidebar-hdr {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .wo-sidebar-card .sidebar-hdr i { color: #667eea; font-size: 1rem; }
    .wo-sidebar-card .sidebar-hdr h6 { margin: 0; font-weight: 600; font-size: 0.9rem; color: #1e293b; }
    .wo-sidebar-card .sidebar-bdy { padding: 1.25rem; }

    /* Action Cards */
    .action-card { border-left: 4px solid transparent; }
    .action-card.accept-card { border-left-color: #3b82f6; background: linear-gradient(135deg, #f0f7ff, #fff); }
    .action-card.accept-card .card-hdr { background: rgba(59,130,246,0.06); }
    .action-card.accept-card .card-hdr i { color: #2563eb; }
    .action-card.tech-card { border-left-color: #f59e0b; background: linear-gradient(135deg, #fffbf0, #fff); }
    .action-card.tech-card .card-hdr { background: rgba(245,158,11,0.06); }
    .action-card.tech-card .card-hdr i { color: #d97706; }
    .action-card.verify-card { border-left-color: #06b6d4; background: linear-gradient(135deg, #f0fdfa, #fff); }
    .action-card.verify-card .card-hdr { background: rgba(6,182,212,0.06); }
    .action-card.verify-card .card-hdr i { color: #0891b2; }

    /* Action Buttons */
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        border: none;
        color: #fff;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-action:hover {
        transform: translateY(-1px);
        color: #fff;
    }
    .btn-accept { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .btn-accept:hover { box-shadow: 0 4px 16px rgba(59,130,246,0.4); }
    .btn-start { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .btn-start:hover { box-shadow: 0 4px 16px rgba(245,158,11,0.4); }
    .btn-complete { background: linear-gradient(135deg, #22c55e, #16a34a); }
    .btn-complete:hover { box-shadow: 0 4px 16px rgba(34,197,94,0.4); }
    .btn-verify { background: linear-gradient(135deg, #06b6d4, #0891b2); }
    .btn-verify:hover { box-shadow: 0 4px 16px rgba(6,182,212,0.4); }
    .btn-assign { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
    .btn-assign:hover { box-shadow: 0 4px 16px rgba(139,92,246,0.4); }
    .btn-save {
        background: linear-gradient(135deg, #667eea, #764ba2);
    }
    .btn-save:hover { box-shadow: 0 4px 16px rgba(102,126,234,0.4); }

    /* Form Elements */
    .modern-textarea {
        border-radius: 12px !important;
        border: 2px solid #e2e8f0 !important;
        padding: 0.875rem 1rem !important;
        font-size: 0.9rem;
        transition: all 0.2s ease !important;
        resize: vertical;
    }
    .modern-textarea:focus {
        border-color: #667eea !important;
        box-shadow: 0 0 0 4px rgba(102,126,234,0.15) !important;
    }
    .modern-select {
        border-radius: 12px !important;
        border: 2px solid #e2e8f0 !important;
        padding: 0.625rem 1rem !important;
        font-size: 0.9rem;
        transition: all 0.2s ease !important;
    }
    .modern-select:focus {
        border-color: #667eea !important;
        box-shadow: 0 0 0 4px rgba(102,126,234,0.15) !important;
    }
    .modern-input {
        border-radius: 12px !important;
        border: 2px solid #e2e8f0 !important;
        padding: 0.625rem 1rem !important;
        font-size: 0.875rem;
        transition: all 0.2s ease !important;
    }
    .modern-input:focus {
        border-color: #667eea !important;
        box-shadow: 0 0 0 4px rgba(102,126,234,0.15) !important;
    }
    .form-label-sm {
        font-size: 0.8rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.5rem;
        display: block;
    }

    /* Info Items */
    .info-row {
        display: flex;
        padding: 0.5rem 0;
        font-size: 0.85rem;
        border-bottom: 1px solid #f1f5f9;
    }
    .info-row:last-child { border-bottom: none; }
    .info-label { color: #64748b; min-width: 90px; font-weight: 500; }
    .info-value { color: #1e293b; font-weight: 500; }

    /* Comments */
    .comment-item {
        display: flex;
        gap: 0.75rem;
        padding: 1rem 0;
        border-bottom: 1px solid #f1f5f9;
    }
    .comment-item:last-of-type { border-bottom: none; }
    .comment-avatar {
        width: 36px; height: 36px; min-width: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.85rem; font-weight: 700;
    }
    .comment-content { flex: 1; min-width: 0; }
    .comment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.25rem;
    }
    .comment-header strong { font-size: 0.85rem; color: #1e293b; }
    .comment-time { font-size: 0.75rem; color: #94a3b8; }
    .comment-content p { margin: 0; font-size: 0.875rem; color: #475569; }

    /* Activity Timeline */
    .activity-timeline { position: relative; padding-left: 1.5rem; }
    .activity-timeline::before {
        content: '';
        position: absolute;
        left: 7px;
        top: 0; bottom: 0;
        width: 2px;
        background: #e2e8f0;
    }
    .timeline-item {
        position: relative;
        padding-bottom: 1.25rem;
        padding-left: 1.25rem;
    }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-dot {
        position: absolute;
        left: -1.5rem;
        top: 4px;
        width: 16px; height: 16px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #667eea;
    }
    .timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .timeline-header strong {
        font-size: 0.85rem;
        color: #1e293b;
    }
    .timeline-time {
        font-size: 0.725rem;
        color: #94a3b8;
    }
    .timeline-actor {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 0.125rem;
    }
    .timeline-note {
        font-size: 0.825rem;
        color: #475569;
        margin-top: 0.375rem;
        padding: 0.5rem 0.75rem;
        background: #f8fafc;
        border-radius: 8px;
        border-left: 3px solid #e2e8f0;
    }

    /* Attachment Items */
    .attach-item {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.625rem 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.85rem;
    }
    .attach-item:last-of-type { border-bottom: none; }
    .attach-icon {
        width: 36px; height: 36px; min-width: 36px;
        border-radius: 10px;
        background: #f1f5f9;
        display: flex; align-items: center; justify-content: center;
        color: #667eea;
    }
    .attach-info { flex: 1; min-width: 0; }
    .attach-name { font-weight: 500; color: #1e293b; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .attach-name:hover { color: #667eea; }
    .attach-date { font-size: 0.725rem; color: #94a3b8; }

    /* Status Badge (reuse from list) */
    .status-badge-lg {
        display: inline-flex; align-items: center; gap: 0.375rem;
        padding: 0.3rem 0.75rem; border-radius: 50px;
        font-size: 0.75rem; font-weight: 600;
    }
    .status-badge-lg.s-open { background: #dbeafe; color: #1d4ed8; }
    .status-badge-lg.s-assigned { background: #ede9fe; color: #6d28d9; }
    .status-badge-lg.s-in_progress { background: #fef3c7; color: #92400e; }
    .status-badge-lg.s-completed { background: #dcfce7; color: #166534; }
    .status-badge-lg.s-verified { background: #cffafe; color: #155e75; }
    .status-badge-lg.s-closed { background: #f1f5f9; color: #475569; }

    /* Toast Messages */
    .wo-toast-container {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-width: 420px;
    }
    .wo-toast {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem 1.25rem;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 500;
        box-shadow: 0 8px 32px rgba(0,0,0,0.12);
        animation: woToastIn 0.3s ease;
        color: #fff;
    }
    .wo-toast.toast-success { background: linear-gradient(135deg, #22c55e, #16a34a); }
    .wo-toast.toast-error { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .wo-toast.toast-warning { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .wo-toast.toast-info { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .wo-toast .toast-close {
        margin-left: auto;
        background: none; border: none; color: rgba(255,255,255,0.7);
        cursor: pointer; font-size: 1.1rem; padding: 0;
    }
    .wo-toast .toast-close:hover { color: #fff; }
    @keyframes woToastIn {
        from { opacity: 0; transform: translateX(100px); }
        to { opacity: 1; transform: translateX(0); }
    }

    /* WO Type Badge */
    .hero-badge.type-badge { background: rgba(255,255,255,0.2); }

    /* Reject Button */
    .btn-reject {
        background: linear-gradient(135deg, #ef4444, #dc2626);
    }
    .btn-reject:hover { box-shadow: 0 4px 16px rgba(239,68,68,0.4); }

    /* Attachment Image Preview */
    .attach-preview {
        width: 48px; height: 48px; min-width: 48px;
        border-radius: 10px;
        object-fit: cover;
        border: 2px solid #e2e8f0;
        cursor: pointer;
        transition: transform 0.2s;
    }
    .attach-preview:hover { transform: scale(1.1); }
    .attach-icon-file {
        width: 48px; height: 48px; min-width: 48px;
        border-radius: 10px;
        background: #f1f5f9;
        display: flex; align-items: center; justify-content: center;
        color: #667eea; font-size: 1.2rem;
    }

    /* Image Lightbox */
    .wo-lightbox {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.85);
        z-index: 10000;
        justify-content: center;
        align-items: center;
        cursor: pointer;
    }
    .wo-lightbox.active { display: flex; }
    .wo-lightbox img {
        max-width: 90vw;
        max-height: 90vh;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    /* Loading Spinner on Buttons */
    .btn-action.is-loading {
        pointer-events: none;
        opacity: 0.7;
    }
    .btn-action.is-loading .spinner-border {
        width: 1rem; height: 1rem;
        border-width: 2px;
    }

    /* SLA / Planned Date Highlight */
    .info-row .sla-overdue {
        color: #dc2626;
        font-weight: 700;
    }
    .info-row .sla-ok {
        color: #16a34a;
        font-weight: 600;
    }

    /* Responsive */
    @media (max-width: 991.98px) {
        .wo-detail-hero { padding: 1.5rem; border-radius: 16px; }
        .wo-detail-hero h1 { font-size: 1.3rem; }
        .hero-meta { text-align: left; margin-top: 1rem; }
        .hero-meta div { justify-content: flex-start; }
    }
    @media (max-width: 767.98px) {
        .wo-stepper-wrap { padding: 1rem; }
    }

    /* Print Styles */
    @media print {
        body { background: #fff !important; }
        .btn-back, .btn-action, .btn-save, .btn-assign, .btn-reject,
        .action-card, .wo-sidebar-card:has(.btn-action),
        .sp-picker, .sp-custom-add,
        .wo-toast-container, .wo-lightbox,
        form .modern-textarea, form .modern-select, form .modern-input,
        #comment, #attachment,
        .btn-print-wo, nav, .sidebar, footer { display: none !important; }
        .wo-detail-hero {
            background: #334155 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            border-radius: 0 !important;
        }
        .wo-card, .wo-sidebar-card {
            box-shadow: none !important;
            border: 1px solid #ccc !important;
            break-inside: avoid;
        }
        .col-lg-8, .col-lg-4 { width: 100% !important; max-width: 100% !important; }
    }
</style>
{% endblock %}

{% block content %}
<!-- Toast Messages -->
{% if messages %}
<div class="wo-toast-container" id="wo-toasts">
    {% for message in messages %}
    <div class="wo-toast toast-{{ message.tags|default:'info' }}">
        <i class="bi {% if message.tags == 'success' %}bi-check-circle-fill{% elif message.tags == 'error' %}bi-x-circle-fill{% elif message.tags == 'warning' %}bi-exclamation-triangle-fill{% else %}bi-info-circle-fill{% endif %}"></i>
        <span>{{ message }}</span>
        <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
    </div>
    {% endfor %}
</div>
{% endif %}

<div class="container py-4">
    <!-- Back Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <a href="{% url 'workorder_list' %}" class="btn-back mb-0">
            <i class="bi bi-arrow-left"></i> กลับไปรายการใบงาน
        </a>
        <button type="button" class="btn-action btn-print-wo" onclick="window.print()" style="background:linear-gradient(135deg,#64748b,#475569); padding:0.5rem 1rem; font-size:0.8rem;">
            <i class="bi bi-printer-fill"></i> พิมพ์ใบงาน
        </button>
    </div>

    <!-- Hero Section -->
    <div class="wo-detail-hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="wo-detail-id">Work Order #{{ wo.id }}</div>
                <h1>{{ wo.title }}
                    {% if wo.accepted_title_suggestion %}
                        <span class="hero-badge suggest-badge"><i class="bi bi-lightbulb-fill"></i> คำแนะนำ</span>
                    {% endif %}
                </h1>
                <div class="hero-badges">
                    <span class="hero-badge s-{{ wo.status }}">{{ wo.get_status_display }}</span>
                    <span class="hero-badge p-{{ wo.priority }}">
                        {% if wo.priority == 'high' %}<i class="bi bi-exclamation-triangle-fill"></i> {% endif %}{{ wo.get_priority_label }}
                    </span>
                    {% if wo.workorder_type %}
                        <span class="hero-badge type-badge">
                            <i class="bi bi-tag-fill"></i> {{ wo.get_workorder_type_display }}
                        </span>
                    {% endif %}
                    {% if wo.origin_request %}
                        <a href="{% url 'service_request_detail' wo.origin_request.id %}" class="hero-badge sr-badge text-white text-decoration-none">
                            <i class="bi bi-link-45deg"></i> SR#{{ wo.origin_request.id }}
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="hero-meta">
                <div><i class="bi bi-person-fill"></i> {{ wo.reported_by|default:"-" }}</div>
                <div><i class="bi bi-calendar3"></i> {{ wo.reported_at|thai_datetime }}</div>
                {% if wo.equipment %}
                    <div><i class="bi bi-cpu-fill"></i> {{ wo.equipment.equipment_id }}</div>
                {% endif %}
                {% if wo.assigned_to %}
                    <div><i class="bi bi-person-check-fill"></i> {{ wo.assigned_to.get_full_name|default:wo.assigned_to.username }}</div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Workflow Stepper -->
    {% with s=wo.status %}
    <div class="wo-stepper-wrap">
        <div class="wo-stepper">
            <div class="stepper-step {% if s == 'open' %}current{% else %}done{% endif %}">
                <div class="stepper-dot">{% if s != 'open' %}<i class="bi bi-check"></i>{% else %}1{% endif %}</div>
                <span class="stepper-label">Open</span>
            </div>
            <div class="stepper-connector {% if s != 'open' %}filled{% endif %}"></div>

            <div class="stepper-step {% if s == 'assigned' %}current{% elif s == 'in_progress' or s == 'completed' or s == 'verified' or s == 'closed' %}done{% endif %}">
                <div class="stepper-dot">{% if s == 'in_progress' or s == 'completed' or s == 'verified' or s == 'closed' %}<i class="bi bi-check"></i>{% else %}2{% endif %}</div>
                <span class="stepper-label">Assigned</span>
            </div>
            <div class="stepper-connector {% if s == 'in_progress' or s == 'completed' or s == 'verified' or s == 'closed' %}filled{% endif %}"></div>

            <div class="stepper-step {% if s == 'in_progress' %}current{% elif s == 'completed' or s == 'verified' or s == 'closed' %}done{% endif %}">
                <div class="stepper-dot">{% if s == 'completed' or s == 'verified' or s == 'closed' %}<i class="bi bi-check"></i>{% else %}3{% endif %}</div>
                <span class="stepper-label">In Progress</span>
            </div>
            <div class="stepper-connector {% if s == 'completed' or s == 'verified' or s == 'closed' %}filled{% endif %}"></div>

            <div class="stepper-step {% if s == 'completed' %}current{% elif s == 'verified' or s == 'closed' %}done{% endif %}">
                <div class="stepper-dot">{% if s == 'verified' or s == 'closed' %}<i class="bi bi-check"></i>{% else %}4{% endif %}</div>
                <span class="stepper-label">Completed</span>
            </div>
            <div class="stepper-connector {% if s == 'verified' or s == 'closed' %}filled{% endif %}"></div>

            <div class="stepper-step {% if s == 'verified' %}current{% elif s == 'closed' %}done{% endif %}">
                <div class="stepper-dot">{% if s == 'closed' %}<i class="bi bi-check"></i>{% else %}5{% endif %}</div>
                <span class="stepper-label">Verified</span>
            </div>
        </div>
    </div>
    {% endwith %}

    <!-- Main Form -->
    <form method="post" enctype="multipart/form-data">
        {% csrf_token %}

        <div class="row g-4">
            <!-- ===== Main Column ===== -->
            <div class="col-lg-8">

                <!-- Accept Request Action -->
                {% if wo.status == 'open' and perms.cmms.change_workorder %}
                <div class="wo-card action-card accept-card">
                    <div class="card-hdr">
                        <i class="bi bi-clipboard-check-fill"></i>
                        <h5>รับคำขอ (Officer Review)</h5>
                    </div>
                    <div class="card-bdy">
                        <label for="accepted_note" class="form-label-sm">หมายเหตุการรับคำขอ</label>
                        <textarea id="accepted_note" name="accepted_note" class="form-control modern-textarea" rows="2" placeholder="หมายเหตุการรับคำขอ..."></textarea>
                        <div class="mt-3">
                            <button type="submit" name="action" value="accept_request" class="btn-action btn-accept">
                                <i class="bi bi-check-circle-fill"></i> รับคำขอและส่งต่อ
                            </button>
                        </div>
                    </div>
                </div>
                {% endif %}

                <!-- Description & Technician Report -->
                <div class="wo-card">
                    <div class="card-hdr">
                        <i class="bi bi-card-text"></i>
                        <h5>รายละเอียด / ปัญหาที่พบ</h5>
                    </div>
                    <div class="card-bdy">
                        {% if wo.description %}
                            <div style="white-space:pre-wrap; font-size:0.9rem; color:#334155;">{{ wo.description }}</div>
                        {% else %}
                            <p class="text-muted mb-0">ไม่มีรายละเอียด</p>
                        {% endif %}

                        {% if wo.technician_report %}
                        <hr>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-clipboard2-pulse text-success"></i>
                            <span class="form-label-sm mb-0" style="color:#16a34a">รายงานจากช่าง</span>
                        </div>
                        <div style="white-space:pre-wrap; font-size:0.875rem; color:#334155; padding:0.75rem; background:#f0fdf4; border-radius:10px; border-left:4px solid #22c55e;">{{ wo.technician_report }}</div>
                        {% endif %}
                    </div>
                </div>


                <!-- Technician Actions -->
                {% if request.user == wo.assigned_to %}
                <div class="wo-card action-card tech-card">
                    <div class="card-hdr">
                        <i class="bi bi-tools"></i>
                        <h5>ดำเนินงาน (ช่าง)</h5>
                    </div>
                    <div class="card-bdy">
                        {% if wo.status == 'assigned' %}
                        <p class="text-muted small mb-2">คลิกเพื่อเริ่มดำเนินงานตามใบสั่งงานนี้</p>
                        <button type="submit" name="action" value="tech_start" class="btn-action btn-start">
                            <i class="bi bi-play-circle-fill"></i> เริ่มงาน
                        </button>
                        {% endif %}

                        {% if wo.status == 'in_progress' %}
                        <label for="technician_cause" class="form-label-sm">สาเหตุ</label>
                        <textarea id="technician_cause" name="technician_cause" class="form-control modern-textarea" rows="3" placeholder="อาการเสียที่พบเกิดจาก...">{% if wo.technician_report %}{% comment %}Existing report is combined; leave blank to avoid overwriting{% endcomment %}{% endif %}</textarea>

                        <label for="technician_analysis" class="form-label-sm">วิเคราะห์สาเหตุ (RCA)</label>
                        <select id="technician_analysis" name="technician_analysis" class="form-select modern-select">
                            <option value="">-- เลือกการวิเคราะห์สาเหตุ --</option>
                            {% for g in rca_groups %}
                                <optgroup label="{{ g.group.label }}">
                                    {% for c in g.children %}
                                        <option value="{{ c.label|escape }}">{{ c.label }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>

                        <label for="technician_method" class="form-label-sm">วิธีการดำเนินงาน</label>
                        <select id="technician_method" name="technician_method" class="form-select modern-select">
                            <option value="inhouse">ดำเนินการเอง (Inhouse)</option>
                            <option value="outsource">ผู้ให้บริการภายนอก (Outsource)</option>
                        </select>

                        <!-- ── เบิกอะไหล่ (Dynamic Spare Parts Picker) ── -->
                        <label class="form-label-sm">เบิกอะไหล่</label>
                        <div class="sp-picker" style="background:#f8fafc; border-radius:12px; border:2px solid #e2e8f0; padding:1rem; margin-bottom:1rem;">
                            <!-- Search -->
                            <div class="position-relative mb-2">
                                <i class="bi bi-search" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:0.85rem;"></i>
                                <input type="text" id="sp-search" class="form-control modern-input" style="padding-left:2.25rem !important;" placeholder="ค้นหาอะไหล่ (รหัส / ชื่อ)..." autocomplete="off">
                            </div>
                            <!-- Search Results Dropdown -->
                            <div id="sp-results" style="display:none; max-height:220px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:10px; background:#fff; box-shadow:0 4px 16px rgba(0,0,0,0.08);"></div>
                            <!-- Selected spare parts table -->
                            <div id="sp-selected-wrap" style="display:none; margin-top:0.75rem;">
                                <table class="table table-sm mb-0" style="font-size:0.82rem;">
                                    <thead>
                                        <tr style="background:#f1f5f9;">
                                            <th style="border-radius:8px 0 0 0; padding:0.5rem 0.75rem;">รหัส</th>
                                            <th style="padding:0.5rem 0.75rem;">ชื่ออะไหล่</th>
                                            <th style="padding:0.5rem 0.75rem; width:80px; text-align:center;">คงเหลือ</th>
                                            <th style="padding:0.5rem 0.75rem; width:90px; text-align:center;">จำนวนเบิก</th>
                                            <th style="border-radius:0 8px 0 0; padding:0.5rem 0.75rem; width:40px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="sp-selected-body"></tbody>
                                </table>
                            </div>
                            <input type="hidden" name="spare_parts_data" id="spare_parts_data" value="[]">
                        </div>

                        <!-- ── อะไหล่อื่นๆ (Custom Spare Part) ── -->
                        <div class="sp-custom-add" style="background:#fffbf0; border-radius:12px; border:2px dashed #f59e0b; padding:1rem; margin-bottom:1rem;">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-plus-circle-fill" style="color:#f59e0b;"></i>
                                <span style="font-size:0.82rem; font-weight:600; color:#92400e;">เพิ่มอะไหล่อื่นๆ (ไม่มีในคลัง)</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-5">
                                    <input type="text" id="sp-custom-name" class="form-control modern-input" placeholder="ชื่ออะไหล่" style="font-size:0.82rem !important;">
                                </div>
                                <div class="col-2">
                                    <input type="number" id="sp-custom-qty" class="form-control modern-input" placeholder="จำนวน" min="1" value="1" style="font-size:0.82rem !important; text-align:center;">
                                </div>
                                <div class="col-2">
                                    <input type="text" id="sp-custom-unit" class="form-control modern-input" placeholder="หน่วย" value="ชิ้น" style="font-size:0.82rem !important;">
                                </div>
                                <div class="col-2">
                                    <input type="number" id="sp-custom-cost" class="form-control modern-input" placeholder="ราคา/หน่วย" min="0" step="0.01" style="font-size:0.82rem !important;">
                                </div>
                                <div class="col-1 d-flex align-items-end">
                                    <button type="button" id="sp-custom-add-btn" style="background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff; border:none; border-radius:10px; padding:0.5rem 0.75rem; font-size:0.82rem; font-weight:600; cursor:pointer; width:100%;" title="เพิ่ม">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <label for="technician_actions" class="form-label-sm">รายละเอียดการดำเนินงาน / แนวทางแก้ไข</label>
                        <textarea id="technician_actions" name="technician_actions" class="form-control modern-textarea" rows="3" placeholder="แนวทางแก้ไข / การแก้ไขที่ทำไปแล้ว..."></textarea>                        
                        <div class="mt-3">
                            <button type="submit" name="action" value="tech_complete" class="btn-action btn-complete">
                                <i class="bi bi-check-all"></i> บันทึกผลการดำเนินงาน
                            </button>
                        </div>                        
                        {% endif %}
                    </div>
                </div>
                {% endif %}

                <!-- Used Spare Parts (shown after completion) -->
                {% if used_spare_parts %}
                <div class="wo-card">
                    <div class="card-hdr">
                        <i class="bi bi-box-seam-fill"></i>
                        <h5>อะไหล่ที่เบิกใช้ <span class="text-muted fw-normal" style="font-size:0.8rem">({{ used_spare_parts|length }})</span></h5>
                    </div>
                    <div class="card-bdy">
                        <table class="table table-sm mb-0" style="font-size:0.85rem;">
                            <thead>
                                <tr style="background:#f1f5f9;">
                                    <th style="padding:0.5rem 0.75rem;">รหัส</th>
                                    <th style="padding:0.5rem 0.75rem;">ชื่ออะไหล่</th>
                                    <th style="padding:0.5rem 0.75rem; text-align:center;">จำนวน</th>
                                    <th style="padding:0.5rem 0.75rem;">หน่วย</th>
                                    <th style="padding:0.5rem 0.75rem; text-align:right;">ราคา/หน่วย</th>
                                    <th style="padding:0.5rem 0.75rem;">สถานะ</th>
                                    <th style="padding:0.5rem 0.75rem;">ดำเนินการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for usp in used_spare_parts %}
                                <tr{% if usp.is_custom %} style="background:#fffbf0;"{% endif %}>
                                    <td style="padding:0.5rem 0.75rem;">
                                        {% if usp.is_custom %}
                                            <span style="background:#fef3c7; color:#92400e; padding:0.15rem 0.5rem; border-radius:6px; font-size:0.78rem; font-weight:600;"><i class="bi bi-box"></i> อื่นๆ</span>
                                        {% else %}
                                            <span style="background:#ede9fe; color:#6d28d9; padding:0.15rem 0.5rem; border-radius:6px; font-size:0.78rem; font-weight:600;">{{ usp.display_code }}</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding:0.5rem 0.75rem; font-weight:500;">{{ usp.display_name }}</td>
                                    <td style="padding:0.5rem 0.75rem; text-align:center; font-weight:600;">{{ usp.quantity }}</td>
                                    <td style="padding:0.5rem 0.75rem; color:#64748b;">{{ usp.display_unit }}</td>
                                    <td style="padding:0.5rem 0.75rem; text-align:right; color:#64748b;">
                                        {% if usp.display_unit_cost %}
                                            {{ usp.display_unit_cost|floatformat:2 }} ฿
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td style="padding:0.5rem 0.75rem;">
                                        {% if usp.is_out_of_stock %}
                                            <span style="background:#fef3c7; color:#92400e; padding:0.15rem 0.5rem; border-radius:6px; font-size:0.75rem; font-weight:600;"><i class="bi bi-cart-plus"></i> รอจัดซื้อ</span>
                                        {% else %}
                                            <span style="background:#dcfce7; color:#166534; padding:0.15rem 0.5rem; border-radius:6px; font-size:0.75rem; font-weight:600;"><i class="bi bi-check-circle"></i> เบิกแล้ว</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding:0.5rem 0.75rem;">
                                        {% if usp.is_out_of_stock and perms.cmms.change_workorder %}
                                            <button type="button" class="btn btn-sm btn-fulfill-sp" data-usp-id="{{ usp.id }}" data-sp-code="{{ usp.display_code }}" data-sp-name="{{ usp.display_name }}" data-sp-qty="{{ usp.quantity }}" data-sp-stock="{% if usp.spare_part %}{{ usp.spare_part.quantity }}{% else %}0{% endif %}" data-sp-custom="{% if usp.is_custom %}1{% else %}0{% endif %}" style="background:linear-gradient(135deg,#22c55e,#16a34a); color:#fff; border:none; border-radius:8px; padding:0.3rem 0.75rem; font-size:0.78rem; font-weight:600; cursor:pointer; transition:all 0.2s;">
                                                <i class="bi bi-box-arrow-in-down"></i> รับอะไหล่แล้ว
                                            </button>
                                        {% elif not usp.is_out_of_stock %}
                                            <span style="color:#94a3b8; font-size:0.78rem;">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        {% if has_pending_procurement %}
                        <div style="margin-top:1rem; padding:0.75rem 1rem; background:#fef3c7; border-radius:10px; border-left:4px solid #f59e0b; font-size:0.82rem; color:#92400e;">
                            <i class="bi bi-exclamation-triangle-fill"></i> มีอะไหล่รอจัดซื้อ {{ pending_procurement_count }} รายการ — กรุณาเติมสต็อกและกด "รับอะไหล่แล้ว"
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}

                <!-- Engineer Verification -->
                {% if perms.cmms.change_workorder and wo.status == 'completed' %}
                <div class="wo-card action-card verify-card">
                    <div class="card-hdr">
                        <i class="bi bi-shield-check"></i>
                        <h5>ตรวจสอบโดยวิศวกร</h5>
                    </div>
                    <div class="card-bdy">
                        <label for="verified_note" class="form-label-sm">Verification Note</label>
                        <textarea id="verified_note" name="verified_note" class="form-control modern-textarea" rows="2" placeholder="หมายเหตุการตรวจสอบ...">{{ wo.verified_note }}</textarea>
                        <div class="mt-3 d-flex gap-2 flex-wrap">
                            <button type="submit" name="action" value="engineer_verify" class="btn-action btn-verify">
                                <i class="bi bi-patch-check-fill"></i> ตรวจสอบและยืนยัน
                            </button>
                            <button type="submit" name="action" value="engineer_reject" class="btn-action btn-reject" onclick="return confirm('ยืนยันส่งกลับให้ช่างแก้ไข?')">
                                <i class="bi bi-arrow-return-left"></i> ส่งกลับแก้ไข
                            </button>
                        </div>
                    </div>
                </div>
                {% endif %}

                <!-- Notes -->
                <div class="wo-card">
                    <div class="card-hdr">
                        <i class="bi bi-sticky-fill"></i>
                        <h5>บันทึก</h5>
                    </div>
                    <div class="card-bdy">
                        <textarea id="notes" name="notes" class="form-control modern-textarea" rows="3" placeholder="บันทึกเพิ่มเติม...">{{ wo.notes }}</textarea>
                    </div>
                </div>

                <!-- Comments -->
                <div class="wo-card">
                    <div class="card-hdr">
                        <i class="bi bi-chat-dots-fill"></i>
                        <h5>ความคิดเห็น<span class="text-muted fw-normal ms-1" style="font-size:0.8rem">({{ comments|length }})</span></h5>
                    </div>
                    <div class="card-bdy">
                        {% for c in comments %}
                        <div class="comment-item">
                            <div class="comment-avatar">
                                {% if c.author %}{{ c.author.username|slice:":1"|upper }}{% else %}S{% endif %}
                            </div>
                            <div class="comment-content">
                                <div class="comment-header">
                                    <strong>{% if c.author %}{{ c.author.username }}{% else %}System{% endif %}</strong>
                                    <span class="comment-time">{{ c.created_at|thai_datetime }}</span>
                                </div>
                                <p>{{ c.text }}</p>
                            </div>
                        </div>
                        {% empty %}
                        <p class="text-muted mb-3">ยังไม่มีความคิดเห็น</p>
                        {% endfor %}

                        <hr>
                        <label for="comment" class="form-label-sm">เพิ่มความคิดเห็น</label>
                        <textarea id="comment" name="comment" class="form-control modern-textarea" rows="3" placeholder="พิมพ์ความคิดเห็น..."></textarea>
                    </div>
                </div>

                <!-- Activity History -->
                <div class="wo-card">
                    <div class="card-hdr">
                        <i class="bi bi-clock-history"></i>
                        <h5>ประวัติการดำเนินการ</h5>
                    </div>
                    <div class="card-bdy">
                        {% if logs and logs.count %}
                        <div class="activity-timeline">
                            {% for log in logs %}
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div>
                                    <div class="timeline-header">
                                        <strong>{{ log.action|title }}</strong>
                                        <span class="timeline-time">{{ log.created_at|thai_datetime }}</span>
                                    </div>
                                    <div class="timeline-actor">
                                        {% if log.actor %}{{ log.actor.get_full_name|default:log.actor.username }}{% else %}System{% endif %}
                                    </div>
                                    {% if log.note %}
                                    <div class="timeline-note">{{ log.note }}</div>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                        {% else %}
                        <p class="text-muted mb-0">ยังไม่มีประวัติการดำเนินการ</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- ===== Sidebar ===== -->
            <div class="col-lg-4">
                <!-- Assignment -->
                {% if perms.cmms.change_workorder %}
                <div class="wo-sidebar-card">
                    <div class="sidebar-hdr">
                        <i class="bi bi-person-check-fill"></i>
                        <h6>มอบหมายงาน</h6>
                    </div>
                    <div class="sidebar-bdy">
                        <label for="assigned_to" class="form-label-sm">มอบหมายช่าง <span style="color:#94a3b8; font-weight:400;">(เลือกทีหลังก็ได้)</span></label>
                        <select id="assigned_to" name="assigned_to" class="form-select modern-select" aria-label="มอบหมายงานให้ช่าง">
                            <option value="">-- ยังไม่มอบหมาย --</option>
                            {% for t in technicians %}
                                {% if t.user %}
                                <option value="{{ t.user.id }}" {% if wo.assigned_to and wo.assigned_to.id == t.user.id %}selected{% endif %}>
                                    {% if t.prefix_name == 'other' %}{{ t.prefix_name_custom }}{% else %}{{ t.prefix_name }}{% endif %} {{ t.name }}
                                </option>
                                {% endif %}
                            {% endfor %}
                        </select>
                        <button type="submit" name="action" value="assign_to_tech" class="btn-action btn-assign w-100 mt-2 justify-content-center">
                            <i class="bi bi-person-plus-fill"></i> มอบหมายงาน
                        </button>
                    </div>
                </div>
                {% endif %}

                <!-- Status & Save -->
                {% if perms.cmms.change_workorder %}
                <div class="wo-sidebar-card">
                    <div class="sidebar-hdr">
                        <i class="bi bi-gear-fill"></i>
                        <h6>สถานะและบันทึก</h6>
                    </div>
                    <div class="sidebar-bdy">
                        <label for="status" class="form-label-sm">สถานะใบงาน</label>
                        <select id="status" name="status" class="form-select modern-select" aria-label="สถานะใบงาน">
                            {% for val, label in wo.STATUS_CHOICES %}
                            <option value="{{ val }}" {% if wo.status == val %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="btn-action btn-save w-100 mt-3 justify-content-center">
                            <i class="bi bi-floppy-fill"></i> บันทึก
                        </button>
                    </div>
                </div>
                {% endif %}

                <!-- Equipment Info -->
                <div class="wo-sidebar-card">
                    <div class="sidebar-hdr">
                        <i class="bi bi-cpu-fill"></i>
                        <h6>อุปกรณ์</h6>
                    </div>
                    <div class="sidebar-bdy">
                        {% if wo.equipment %}
                        <div class="info-row">
                            <span class="info-label">รหัส</span>
                            <span class="info-value">{{ wo.equipment.equipment_id }}</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">ชื่อ (TH)</span>
                            <span class="info-value">{{ wo.equipment.equipment_name_TH|default:"-" }}</span>
                        </div>
                        {% if wo.equipment.equipment_name_EN %}
                        <div class="info-row">
                            <span class="info-label">ชื่อ (EN)</span>
                            <span class="info-value">{{ wo.equipment.equipment_name_EN }}</span>
                        </div>
                        {% endif %}
                        {% if wo.equipment.equipment_brand %}
                        <div class="info-row">
                            <span class="info-label">ยี่ห้อ</span>
                            <span class="info-value">{{ wo.equipment.equipment_brand }}</span>
                        </div>
                        {% endif %}
                        {% if wo.equipment.equipment_model %}
                        <div class="info-row">
                            <span class="info-label">รุ่น</span>
                            <span class="info-value">{{ wo.equipment.equipment_model }}</span>
                        </div>
                        {% endif %}
                        {% if wo.equipment.equipment_sn %}
                        <div class="info-row">
                            <span class="info-label">S/N</span>
                            <span class="info-value">{{ wo.equipment.equipment_sn }}</span>
                        </div>
                        {% endif %}
                        {% else %}
                        <p class="text-muted small mb-0">ไม่มีข้อมูลอุปกรณ์</p>
                        {% endif %}
                    </div>
                </div>

                <!-- Date Info -->
                <div class="wo-sidebar-card">
                    <div class="sidebar-hdr">
                        <i class="bi bi-calendar3"></i>
                        <h6>ข้อมูลวันที่</h6>
                    </div>
                    <div class="sidebar-bdy">
                        <div class="info-row">
                            <span class="info-label">แจ้งเมื่อ</span>
                            <span class="info-value">{{ wo.reported_at|thai_datetime }}</span>
                        </div>
                        {% if wo.planned_start %}
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-calendar-event text-primary" style="font-size:0.75rem;"></i> แผนเริ่ม</span>
                            <span class="info-value">{{ wo.planned_start|thai_datetime }}</span>
                        </div>
                        {% endif %}
                        {% if wo.planned_end %}
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-calendar-check text-primary" style="font-size:0.75rem;"></i> แผนเสร็จ</span>
                            <span class="info-value">{{ wo.planned_end|thai_datetime }}</span>
                        </div>
                        {% endif %}
                        {% if wo.accepted_at %}
                        <div class="info-row">
                            <span class="info-label">รับเมื่อ</span>
                            <span class="info-value">{{ wo.accepted_at|thai_datetime }}</span>
                        </div>
                        {% endif %}
                        {% if wo.actual_start %}
                        <div class="info-row">
                            <span class="info-label">เริ่มงาน</span>
                            <span class="info-value">{{ wo.actual_start|thai_datetime }}</span>
                        </div>
                        {% endif %}
                        {% if wo.actual_end %}
                        <div class="info-row">
                            <span class="info-label">เสร็จสิ้น</span>
                            <span class="info-value">{{ wo.actual_end|thai_datetime }}</span>
                        </div>
                        {% endif %}
                        {% if wo.verified_at %}
                        <div class="info-row">
                            <span class="info-label">ยืนยันเมื่อ</span>
                            <span class="info-value">{{ wo.verified_at|thai_datetime }}</span>
                        </div>
                        {% endif %}
                        <div class="info-row">
                            <span class="info-label">อัปเดต</span>
                            <span class="info-value">{{ wo.updated_at|thai_datetime }}</span>
                        </div>
                    </div>
                </div>

                <!-- Attachments -->
                <div class="wo-sidebar-card">
                    <div class="sidebar-hdr">
                        <i class="bi bi-paperclip"></i>
                        <h6>เอกสารแนบ <span class="text-muted fw-normal" style="font-size:0.8rem">({{ attachments|length }})</span></h6>
                    </div>
                    <div class="sidebar-bdy">
                        {% for a in attachments %}
                        <div class="attach-item">
                            {% with fname=a.file.name|lower %}
                            {% if '.jpg' in fname or '.jpeg' in fname or '.png' in fname or '.gif' in fname or '.webp' in fname %}
                                <img src="{{ a.file.url }}" alt="{{ a.file.name }}" class="attach-preview" onclick="openLightbox('{{ a.file.url }}')">
                            {% else %}
                                <div class="attach-icon-file">
                                    {% if '.pdf' in fname %}<i class="bi bi-file-earmark-pdf-fill" style="color:#ef4444;"></i>
                                    {% elif '.doc' in fname or '.docx' in fname %}<i class="bi bi-file-earmark-word-fill" style="color:#2563eb;"></i>
                                    {% elif '.xls' in fname or '.xlsx' in fname %}<i class="bi bi-file-earmark-excel-fill" style="color:#16a34a;"></i>
                                    {% else %}<i class="bi bi-file-earmark-fill"></i>
                                    {% endif %}
                                </div>
                            {% endif %}
                            {% endwith %}
                            <div class="attach-info">
                                <a href="{{ a.file.url }}" class="attach-name" target="_blank">{{ a.file.name|truncatechars:30 }}</a>
                                <span class="attach-date">{{ a.uploaded_at|thai_datetime }}{% if a.uploaded_by %} โดย {{ a.uploaded_by.username }}{% endif %}</span>
                            </div>
                        </div>
                        {% empty %}
                        <p class="text-muted small mb-3">ยังไม่มีเอกสารแนบ</p>
                        {% endfor %}

                        <hr>
                        <label for="attachment" class="form-label-sm">อัพโหลดเอกสาร</label>
                        <input type="file" id="attachment" name="attachment" class="form-control modern-input"
                               accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.doc,.docx,.xls,.xlsx">
                        <small class="text-muted" style="font-size:0.72rem;">รองรับ: PDF, รูปภาพ, Word, Excel (สูงสุด 10MB)</small>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Fulfill Spare Part Confirmation Modal -->
<div class="modal fade" id="fulfillSpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px; border:none; box-shadow:0 8px 32px rgba(0,0,0,0.12);">
            <div class="modal-header" style="border-bottom:1px solid #f1f5f9; padding:1.25rem 1.5rem;">
                <h5 class="modal-title" style="font-size:1rem; font-weight:700; color:#1e293b;"><i class="bi bi-box-arrow-in-down text-success me-2"></i>ยืนยันรับอะไหล่</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding:1.5rem;">
                <p style="font-size:0.9rem; color:#334155; margin-bottom:0.75rem;"><strong>อะไหล่:</strong> <span id="fulfill-sp-code" style="background:#ede9fe; color:#6d28d9; padding:0.15rem 0.5rem; border-radius:6px; font-weight:600;"></span> <span id="fulfill-sp-name"></span></p>
                <p style="font-size:0.9rem; color:#334155; margin-bottom:0.75rem;"><strong>จำนวนที่ต้องเบิก:</strong> <span id="fulfill-sp-qty" style="font-weight:700; color:#1e293b;"></span></p>
                <div id="fulfill-stock-info" style="padding:0.75rem 1rem; border-radius:10px; font-size:0.85rem; margin-bottom:0.5rem;"></div>
                <p style="font-size:0.82rem; color:#64748b; margin-bottom:0;">หลังกดยืนยัน ระบบจะหักสต็อกอัตโนมัติและเปลี่ยนสถานะเป็น "เบิกแล้ว"</p>
            </div>
            <div class="modal-footer" style="border-top:1px solid #f1f5f9; padding:1rem 1.5rem;">
                <button type="button" class="btn btn-sm" data-bs-dismiss="modal" style="border:2px solid #e2e8f0; border-radius:10px; padding:0.4rem 1rem; font-weight:600; color:#64748b;">ยกเลิก</button>
                <form method="post" id="fulfill-form" style="display:inline;">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="fulfill_spare_part">
                    <input type="hidden" name="usp_id" id="fulfill-usp-id" value="">
                    <button type="submit" class="btn btn-sm" style="background:linear-gradient(135deg,#22c55e,#16a34a); color:#fff; border:none; border-radius:10px; padding:0.4rem 1rem; font-weight:600;">
                        <i class="bi bi-check-circle-fill"></i> ยืนยันรับอะไหล่
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
// Fulfill spare part modal logic
(function() {
    document.querySelectorAll('.btn-fulfill-sp').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var uspId = this.dataset.uspId;
            var code = this.dataset.spCode;
            var name = this.dataset.spName;
            var qty = parseInt(this.dataset.spQty);
            var stock = parseInt(this.dataset.spStock);
            var isCustom = this.dataset.spCustom === '1';
            document.getElementById('fulfill-usp-id').value = uspId;
            document.getElementById('fulfill-sp-code').textContent = code;
            document.getElementById('fulfill-sp-name').textContent = name;
            document.getElementById('fulfill-sp-qty').textContent = qty;
            var infoDiv = document.getElementById('fulfill-stock-info');
            if (isCustom) {
                infoDiv.style.background = '#fffbf0';
                infoDiv.innerHTML = '<i class="bi bi-box text-warning"></i> อะไหล่อื่นๆ (จัดซื้อภายนอก) — กดยืนยันเพื่อเปลี่ยนสถานะเป็น "เบิกแล้ว"';
            } else if (stock >= qty) {
                infoDiv.style.background = '#dcfce7';
                infoDiv.innerHTML = '<i class="bi bi-check-circle text-success"></i> สต็อกปัจจุบัน: <strong>' + stock + '</strong> — เพียงพอสำหรับเบิก ' + qty;
            } else {
                infoDiv.style.background = '#fee2e2';
                infoDiv.innerHTML = '<i class="bi bi-exclamation-triangle text-danger"></i> สต็อกปัจจุบัน: <strong>' + stock + '</strong> — ยังไม่พอ (ต้องการ ' + qty + ') กรุณาเติมสต็อกก่อน';
            }
            var modal = new bootstrap.Modal(document.getElementById('fulfillSpModal'));
            modal.show();
        });
    });
})();
</script>

<script>
(function() {
    const searchInput = document.getElementById('sp-search');
    if (!searchInput) return; // not in tech in_progress mode

    const resultsDiv  = document.getElementById('sp-results');
    const selectedBody = document.getElementById('sp-selected-body');
    const selectedWrap = document.getElementById('sp-selected-wrap');
    const hiddenInput  = document.getElementById('spare_parts_data');
    const equipmentId  = '{{ wo.equipment_id|default:"" }}';

    let selectedParts = {}; // {id: {id, code, name, unit, qty, max}}
    let debounceTimer = null;

    function syncHidden() {
        const arr = Object.values(selectedParts).map(p => {
            if (p.isCustom) {
                return {id: 'custom', qty: p.qty, custom_name: p.name, custom_unit_cost: p.unitCost || null, custom_unit: p.unit};
            }
            return {id: p.id, qty: p.qty, out_of_stock: !!p.outOfStock};
        });
        hiddenInput.value = JSON.stringify(arr);
        selectedWrap.style.display = arr.length ? 'block' : 'none';
    }

    function renderSelected() {
        selectedBody.innerHTML = '';
        Object.values(selectedParts).forEach(p => {
            const tr = document.createElement('tr');
            if (p.isCustom) {
                tr.style.background = '#fffbf0';
                tr.innerHTML =
                    '<td style="padding:0.4rem 0.75rem;"><span style="background:#fef3c7; color:#92400e; padding:0.15rem 0.5rem; border-radius:6px; font-size:0.78rem; font-weight:600;"><i class="bi bi-box"></i> อื่นๆ</span></td>' +
                    '<td style="padding:0.4rem 0.75rem; font-weight:500;">' + esc(p.name) + ' <span style="color:#94a3b8; font-size:0.75rem;">(' + esc(p.unit) + ')</span>' + (p.unitCost ? ' <span style="color:#f59e0b; font-size:0.72rem;">' + p.unitCost + ' ฿</span>' : '') + '</td>' +
                    '<td style="padding:0.4rem 0.75rem; text-align:center; color:#f59e0b; font-weight:600;">—</td>' +
                    '<td style="padding:0.4rem 0.75rem; text-align:center;">' +
                        '<input type="number" min="1" value="' + p.qty + '" class="form-control form-control-sm" style="width:70px; margin:0 auto; text-align:center; border-radius:8px; border:2px solid #f59e0b; font-weight:600;" data-sp-id="' + p.id + '">' +
                    '</td>' +
                    '<td style="padding:0.4rem 0.75rem; text-align:center;">' +
                        '<button type="button" class="btn btn-sm p-0" style="color:#ef4444; font-size:1.1rem; line-height:1;" data-sp-remove="' + p.id + '" title="ลบ"><i class="bi bi-x-circle-fill"></i></button>' +
                    '</td>';
            } else {
                tr.innerHTML =
                    '<td style="padding:0.4rem 0.75rem;"><span style="background:#ede9fe; color:#6d28d9; padding:0.15rem 0.5rem; border-radius:6px; font-size:0.78rem; font-weight:600;">' + esc(p.code) + '</span></td>' +
                    '<td style="padding:0.4rem 0.75rem; font-weight:500;">' + esc(p.name) + ' <span style="color:#94a3b8; font-size:0.75rem;">(' + esc(p.unit) + ')</span></td>' +
                    '<td style="padding:0.4rem 0.75rem; text-align:center; color:#64748b;">' + (p.outOfStock ? '<span style="color:#991b1b; font-weight:600;">0 <i class="bi bi-cart-plus" style="color:#f59e0b;"></i></span>' : p.max) + '</td>' +
                    '<td style="padding:0.4rem 0.75rem; text-align:center;">' +
                        '<input type="number" min="1"' + (p.outOfStock ? '' : ' max="' + p.max + '"') + ' value="' + p.qty + '" class="form-control form-control-sm" style="width:70px; margin:0 auto; text-align:center; border-radius:8px; border:2px solid ' + (p.outOfStock ? '#f59e0b' : '#e2e8f0') + '; font-weight:600;" data-sp-id="' + p.id + '">' +
                    '</td>' +
                    '<td style="padding:0.4rem 0.75rem; text-align:center;">' +
                        '<button type="button" class="btn btn-sm p-0" style="color:#ef4444; font-size:1.1rem; line-height:1;" data-sp-remove="' + p.id + '" title="ลบ"><i class="bi bi-x-circle-fill"></i></button>' +
                    '</td>';
            }
            selectedBody.appendChild(tr);
        });
        // Bind qty change
        selectedBody.querySelectorAll('input[data-sp-id]').forEach(function(inp) {
            inp.addEventListener('change', function() {
                const id = this.dataset.spId;
                let v = parseInt(this.value) || 1;
                if (v < 1) v = 1;
                if (!selectedParts[id].outOfStock && !selectedParts[id].isCustom && v > selectedParts[id].max) v = selectedParts[id].max;
                this.value = v;
                selectedParts[id].qty = v;
                syncHidden();
            });
        });
        // Bind remove
        selectedBody.querySelectorAll('[data-sp-remove]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                delete selectedParts[this.dataset.spRemove];
                renderSelected();
                syncHidden();
            });
        });
        syncHidden();
    }

    function esc(s) {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function doSearch(q) {
        let url = '{% url "api_spare_parts_search" %}?q=' + encodeURIComponent(q);
        if (equipmentId) url += '&equipment_id=' + encodeURIComponent(equipmentId);
        fetch(url, {credentials: 'same-origin'})
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.results || !data.results.length) {
                    resultsDiv.innerHTML = '<div style="padding:0.75rem 1rem; color:#94a3b8; font-size:0.82rem;">ไม่พบอะไหล่</div>';
                    resultsDiv.style.display = 'block';
                    return;
                }
                resultsDiv.innerHTML = '';
                data.results.forEach(function(sp) {
                    const alreadyPicked = selectedParts[sp.id];
                    const item = document.createElement('div');
                    item.style.cssText = 'display:flex; align-items:center; gap:0.75rem; padding:0.6rem 1rem; cursor:pointer; border-bottom:1px solid #f1f5f9; transition:background 0.15s;';
                    if (alreadyPicked) item.style.opacity = '0.45';
                    item.innerHTML =
                        '<div style="flex:0 0 auto;">' +
                            '<span style="background:#dbeafe; color:#1d4ed8; padding:0.15rem 0.5rem; border-radius:6px; font-size:0.75rem; font-weight:600;">' + esc(sp.code) + '</span>' +
                        '</div>' +
                        '<div style="flex:1; min-width:0;">' +
                            '<div style="font-weight:500; font-size:0.82rem; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">' + esc(sp.name) + '</div>' +
                            '<div style="font-size:0.72rem; color:#94a3b8;">' + esc(sp.location || '-') + ' &middot; คงเหลือ ' + sp.quantity + ' ' + esc(sp.unit) + '</div>' +
                        '</div>' +
                        '<div style="flex:0 0 auto;">' +
                            '<span style="background:' + (sp.quantity > 0 ? '#dcfce7; color:#166534' : '#fee2e2; color:#991b1b') + '; padding:0.15rem 0.5rem; border-radius:6px; font-size:0.72rem; font-weight:600;">' + (sp.quantity > 0 ? 'มีสต็อก' : 'หมด') + '</span>' +
                        '</div>';
                    item.addEventListener('mouseenter', function() { item.style.background = '#f8fafc'; });
                    item.addEventListener('mouseleave', function() { item.style.background = ''; });
                    if (!alreadyPicked) {
                        item.addEventListener('click', function() {
                            selectedParts[sp.id] = {
                                id: sp.id,
                                code: sp.code,
                                name: sp.name,
                                unit: sp.unit,
                                qty: 1,
                                max: sp.quantity,
                                outOfStock: sp.quantity <= 0
                            };
                            renderSelected();
                            resultsDiv.style.display = 'none';
                            searchInput.value = '';
                        });
                    }
                    resultsDiv.appendChild(item);
                });
                resultsDiv.style.display = 'block';
            })
            .catch(function() {
                resultsDiv.innerHTML = '<div style="padding:0.75rem 1rem; color:#ef4444; font-size:0.82rem;">เกิดข้อผิดพลาด</div>';
                resultsDiv.style.display = 'block';
            });
    }

    searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        const q = this.value.trim();
        if (q.length < 1) {
            resultsDiv.style.display = 'none';
            return;
        }
        debounceTimer = setTimeout(function() { doSearch(q); }, 300);
    });

    searchInput.addEventListener('focus', function() {
        if (this.value.trim().length >= 1) doSearch(this.value.trim());
    });

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.sp-picker')) resultsDiv.style.display = 'none';
    });

    // Custom spare part (add button)
    let customCounter = 0;
    const customAddBtn = document.getElementById('sp-custom-add-btn');
    if (customAddBtn) {
        customAddBtn.addEventListener('click', function() {
            const nameInput = document.getElementById('sp-custom-name');
            const qtyInput = document.getElementById('sp-custom-qty');
            const unitInput = document.getElementById('sp-custom-unit');
            const costInput = document.getElementById('sp-custom-cost');
            const cName = nameInput.value.trim();
            if (!cName) { nameInput.focus(); return; }
            const cQty = parseInt(qtyInput.value) || 1;
            const cUnit = unitInput.value.trim() || 'ชิ้น';
            const cCost = parseFloat(costInput.value) || null;
            customCounter++;
            const cId = 'custom_' + customCounter + '_' + Date.now();
            selectedParts[cId] = {
                id: cId,
                code: 'อื่นๆ',
                name: cName,
                unit: cUnit,
                qty: cQty,
                max: 0,
                outOfStock: false,
                isCustom: true,
                unitCost: cCost
            };
            renderSelected();
            nameInput.value = '';
            qtyInput.value = '1';
            unitInput.value = 'ชิ้น';
            costInput.value = '';
            nameInput.focus();
        });
    }
})();
</script>

<!-- Image Lightbox -->
<div class="wo-lightbox" id="wo-lightbox" onclick="closeLightbox()">
    <img id="lightbox-img" src="" alt="Preview">
</div>

<script>
// Lightbox for image preview
function openLightbox(url) {
    document.getElementById('lightbox-img').src = url;
    document.getElementById('wo-lightbox').classList.add('active');
}
function closeLightbox() {
    document.getElementById('wo-lightbox').classList.remove('active');
    document.getElementById('lightbox-img').src = '';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLightbox();
});

// Auto-dismiss toast messages after 5 seconds
(function() {
    var toasts = document.querySelectorAll('.wo-toast');
    toasts.forEach(function(t) {
        setTimeout(function() {
            t.style.transition = 'opacity 0.5s, transform 0.5s';
            t.style.opacity = '0';
            t.style.transform = 'translateX(100px)';
            setTimeout(function() { t.remove(); }, 500);
        }, 5000);
    });
})();

// Confirm dialog on important action buttons
(function() {
    var confirmMap = {
        'accept_request': 'ยืนยันรับคำขอนี้?',
        'tech_start': 'ยืนยันเริ่มดำเนินงาน?',
        'tech_complete': 'ยืนยันบันทึกผลการดำเนินงาน?',
        'engineer_verify': 'ยืนยันตรวจสอบและอนุมัติ?',
        'assign_to_tech': 'ยืนยันมอบหมายงาน?'
    };
    document.querySelectorAll('button[name="action"]').forEach(function(btn) {
        var msg = confirmMap[btn.value];
        if (msg) {
            btn.addEventListener('click', function(e) {
                if (!confirm(msg)) { e.preventDefault(); }
            });
        }
    });
})();

// Loading spinner on form submit
(function() {
    var forms = document.querySelectorAll('form[method="post"]');
    forms.forEach(function(form) {
        form.addEventListener('submit', function() {
            var btn = form.querySelector('button[type="submit"]:focus') || form.querySelector('.btn-action[type="submit"]');
            if (btn && !btn.classList.contains('is-loading')) {
                var originalHTML = btn.innerHTML;
                btn.classList.add('is-loading');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> กำลังดำเนินการ...';
                // Re-enable after 10s as safety net
                setTimeout(function() {
                    btn.classList.remove('is-loading');
                    btn.innerHTML = originalHTML;
                }, 10000);
            }
        });
    });
})();

// Client-side file upload validation
(function() {
    var fileInput = document.getElementById('attachment');
    if (!fileInput) return;
    var maxSize = 10 * 1024 * 1024; // 10MB
    var allowedExts = ['.pdf','.jpg','.jpeg','.png','.gif','.webp','.doc','.docx','.xls','.xlsx'];
    fileInput.addEventListener('change', function() {
        if (!this.files.length) return;
        var file = this.files[0];
        var ext = '.' + file.name.split('.').pop().toLowerCase();
        if (allowedExts.indexOf(ext) === -1) {
            alert('ไฟล์ประเภทนี้ไม่รองรับ\nรองรับ: PDF, รูปภาพ (JPG/PNG/GIF/WebP), Word, Excel');
            this.value = '';
            return;
        }
        if (file.size > maxSize) {
            alert('ไฟล์ขนาดใหญ่เกินไป (สูงสุด 10MB)\nขนาดไฟล์: ' + (file.size / 1024 / 1024).toFixed(1) + 'MB');
            this.value = '';
        }
    });
})();
</script>
{% endblock %}